rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /seed/{allPaths=**} { allow read: if true; allow write: if false; }
    match /workspaces/{uid}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
